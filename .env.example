# Postgres connection string. Copy this file to `.env` and adjust as needed;
# the server loads `.env` automatically at startup (via dotenvy) if present.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/loan_risk

# Address the Axum server binds to.
BIND_ADDR=0.0.0.0:8080

# Set to any value to skip running migrations at startup (e.g. if you run
# `cargo run -p migration -- up` separately, or in a deploy pipeline where
# migrations run as a distinct step).
# SKIP_MIGRATIONS=1

# Standard env-filter syntax, e.g. "info,api=debug,sqlx=warn".
RUST_LOG=info
